# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.

# Пароль PostgreSQL
POSTGRES_PASSWORD=change-me

# Секрет подписи JWT, не короче 32 символов.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET_KEY=

# Ключ шифрования AES-256: ровно 32 байта в Base64.
# Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=

# Первый администратор (необязательно). Создаётся при старте, если администратора ещё нет.
# Пароль не короче 8 символов.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
